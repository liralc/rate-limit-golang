# HTTP server port.
SERVER_PORT=8080

# Maximum requests per second for a single IP.
RATE_LIMIT_IP=10

# Per-token limits (requests per second), comma separated: token:limit.
# Tokens are sent in the API_KEY header and override the IP limit.
RATE_LIMIT_TOKENS=abc123:100,def456:50

# How long an IP or token stays blocked after exceeding its limit (Go duration: 30s, 5m, 1h).
BLOCK_DURATION=5m

# Read the client IP from X-Forwarded-For / X-Real-IP. Enable only behind a trusted proxy.
TRUST_PROXY_HEADERS=false

# Persistence strategy: redis | memory.
STORAGE_STRATEGY=redis

# Redis connection.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
